# Kullo Partner App Environment Variables
# Copy to .env.local and fill in your values

# API Endpoints
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_AUTH_URL=http://localhost:5000
EXPO_PUBLIC_ORCHESTRATOR_URL=http://localhost:4050

# EAS Project ID (from expo.dev)
EXPO_PUBLIC_PROJECT_ID=your-project-id-here
