{
  "expo": {
    "name": "Kullo",
    "slug": "kullo",
    "version": "0.2.2",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kullo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0C2D29"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.berqenas.kullo",
      "infoPlist": {
        "NSCameraUsageDescription": "Araç fotoğrafları çekmek ve AI araç tanıma için kamera erişimi gerekiyor.",
        "NSPhotoLibraryUsageDescription": "Galeri'den araç fotoğrafı seçmek için izin gerekiyor.",
        "NSLocationWhenInUseUsageDescription": "Yakınınızdaki araçları göstermek için konum kullanılır.",
        "CFBundleDisplayName": "Kullo"
      },
      "buildNumber": "2"
    },
    "android": {
      "package": "com.berqenas.kullo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#013C38"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 2
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "En yakın teslimat adresini seçmek için konum kullanılır."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Araç fotoğrafı çekmek için kamera iznine ihtiyacımız var."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Araç fotoğraflarını seçmek için galeri iznine ihtiyacımız var."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      },
      "projectDomain": "kullo.berqenas.com",
      "apiUrl": "http://localhost:3000",
      "aiUrl": "http://localhost:4000",
      "authUrl": "http://localhost:5000"
    }
  }
}
